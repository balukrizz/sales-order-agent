# Backend configuration. Copy to .env for local dev (never commit .env).
LLM_PROVIDER=mock                     # mock | mistral
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
ENABLE_OCR=false
DB_PATH=database/sales.db             # on Vercel use /tmp/sales.db; on Render /var/data/sales.db
CUSTOMER_MASTER=data/customer_master.csv
MATERIAL_MASTER=data/material_master.csv
# Restrict CORS in production to your frontend origin:
FRONTEND_ORIGIN=*
